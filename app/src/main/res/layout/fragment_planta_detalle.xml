<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#1e5c3d">

            <TextView
                android:id="@+id/tvDetalleEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🌿"
                android:textSize="80sp" />

            <!-- Botón regresar -->
            <TextView
                android:id="@+id/btnRegresar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_circle_dark"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <!-- Overlay inferior con nombre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvDetalleName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Albahaca"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleSci"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ocimum basilicum"
                    android:textColor="#BFD9C8"
                    android:textSize="13sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </FrameLayout>

        <!-- BODY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Chips -->
            <LinearLayout
                android:id="@+id/layoutChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp" />

            <!-- Para qué sirve -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿  ¿Para qué sirve?"
                android:textColor="#1A3A2A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDetalleUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1A3A2A"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="18dp" />

            <!-- Dosis -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊  Dosis recomendada"
                android:textColor="#1A3A2A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_green"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÓMO USARLA:"
                    android:textColor="#5A7A65"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDetalleDosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1A3A2A"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- Contraindicaciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️  Contraindicaciones"
                android:textColor="#1A3A2A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_amber"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TENER PRECAUCIÓN SI:"
                    android:textColor="#5A7A65"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDetalleContra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1A3A2A"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- Interacciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊  Interacciones conocidas"
                android:textColor="#1A3A2A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_red"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONSULTA TU MÉDICO SI TOMAS:"
                    android:textColor="#5A7A65"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDetalleInter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1A3A2A"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- Receta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍵  Cómo preparar"
                android:textColor="#1A3A2A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="18dp" />

            <!-- Fuente -->
            <TextView
                android:id="@+id/tvDetalleFuente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_cream"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="#5A7A65"
                android:textSize="11sp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>